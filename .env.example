# Base de datos (Render Postgres, o local)
DATABASE_URL="postgresql://usuario:password@host:5432/agendabot?schema=public"

# Servidor
PORT=3000

# WhatsApp Business API (Meta) - token de verificación del webhook
WHATSAPP_VERIFY_TOKEN="elige-un-token-secreto-aqui"

# Embedded Signup v4 (Meta) - conectar WhatsApp de una empresa desde el panel
# META_APP_ID: App ID de Meta usado en FB.login() (frontend del panel)
# META_APP_SECRET: App Secret de esa misma App, solo en el backend, para
#   cambiar el "code" corto por el token permanente (POST /empresa/whatsapp/conectar)
META_APP_ID="1064842162565759"
META_APP_SECRET=""

# Anthropic (Claude Haiku para el chatbot)
ANTHROPIC_API_KEY=""

# Panel administrativo/profesional (login)
JWT_SECRET="genera-un-string-largo-y-aleatorio-aqui"
# URL(s) del Static Site del panel en Render, separadas por coma si hay más de una
# (ej. dominio de preview + dominio final). Si se deja vacía, se permite cualquier origen (solo dev).
PANEL_FRONTEND_URL=""

# Flow.cl (pagos recurrentes vía Suscripciones — ver PLAN de flowClient.js)
# NOTA: el código lee FLOW_API_SECRET (no FLOW_SECRET_KEY) — confirmar que el
# nombre configurado en Render coincide, si no el cliente queda "deshabilitado"
# silenciosamente (solo un warning en el log al bootear).
FLOW_API_KEY=""
FLOW_API_SECRET=""
# BACKEND_URL: usado para armar los urlCallback/urlConfirmation que Flow llama
BACKEND_URL=""
# planId de cada Plan creado una vez con scripts/crear-planes-flow.js
FLOW_PLAN_ID_A=""
FLOW_PLAN_ID_B=""
FLOW_PLAN_ID_C=""
FLOW_PLAN_ID_HOSTING=""

# Corte de servicio por prueba vencida sin pago (ver src/jobs/bloquearEmpresasVencidas.js)
# 'true' = el chat deja de responder a los clientes del negocio una vez agotados
# los avisos. Por defecto (vacío/cualquier otro valor) NO corta nada, solo avisa.
BLOQUEO_PRUEBA_VENCIDA_ACTIVO=""
