// ============================================================
// AgendaBot (MultiDigital) — Modelo de datos
// Multi-tenant, multi-rubro, agenda + chatbot + suscripciones
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// RUBROS Y PLANTILLAS
enum ModoOperacionRubro {
  AGENDAMIENTO
  CATALOGO_ROTATIVO
}

model RubroTemplate {
  id            String   @id @default(uuid())
  clave         String   @unique
  nombre        String
  modoOperacion ModoOperacionRubro @default(AGENDAMIENTO)
  camposFicha   Json
  serviciosBase Json
  automatizacionesBase Json
  creadoEn      DateTime @default(now())
  categoriasProductoSugeridas Json?

  empresas Empresa[]
}

// EMPRESAS (TENANTS)
model Empresa {
  id              String   @id @default(uuid())
  nombre          String
  sucursal        String?
  rut             String?
  telefonoContacto String?

  rubroTemplate   RubroTemplate @relation(fields: [rubroTemplateId], references: [id])
  rubroTemplateId String

  logoUrl         String?
  whatsappNumeroId String?
  whatsappWabaId   String?
  whatsappToken    String?

  googleCalendarId    String?
  googleRefreshToken  String?

  direccion         String?
  notaAgendamiento  String?
  informacionAdicional String? @db.Text
  requiereRut       Boolean @default(false)
  sitioWeb        String?

  creadoEn        DateTime @default(now())

  usuarios        Usuario[]
  recursosAgendables RecursoAgendable[]
  clientes        Cliente[]
  servicios       Servicio[]
  citas           Cita[]
  listaEspera     ListaEspera[]
  conversaciones  Conversacion[]
  ventas          Venta[]
  suscripcion     Suscripcion?
  contratos       ContratoAceptado[]

  productos       Producto[]
  campanasEnvio   CampanaEnvio[]
  pedidos         Pedido[]
  
  billeteraCreditos      BilleteraCreditos?
  ordenesCompraCreditos  OrdenCompraCreditos[]

  esDemo         Boolean @default(false)
  demosAsignadas DemoAsignada[]

  profesionales   Profesional[]
  bloqueosProfesional BloqueoProfesional[]

  @@index([rubroTemplateId])
}

// USUARIOS DEL PANEL
enum RolUsuario {
  ADMIN
  RECEPCION
  PROFESIONAL
}

model Usuario {
  id        String     @id @default(uuid())
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  empresaId String

  nombre    String
  email     String     @unique
  passwordHash String
  rol       RolUsuario

  recursoAgendable   RecursoAgendable? @relation(fields: [recursoAgendableId], references: [id])
  recursoAgendableId String?

  creadoEn  DateTime   @default(now())

  @@index([empresaId])
}

// PROFESIONALES (NUEVO - OPCIÓN C)
model Profesional {
  id            String   @id @default(uuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  empresaId     String

  nombre        String
  especialidad  String?
  email         String?
  telefono      String?
  activo        Boolean  @default(true)

  recursosAgendables RecursoAgendable[]
  citasAsignadas     Cita[]
  bloqueosProfesional BloqueoProfesional[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaId])
}

// RECURSOS AGENDABLES
model RecursoAgendable {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  nombre    String
  tipo      String   @default("profesional")

  profesionalId String?
  profesional   Profesional? @relation(fields: [profesionalId], references: [id])

  duracionCitaMinutos   Int @default(30)
  anticipacionMinimaMin Int @default(120)
  horizonteAgendaDias   Int @default(28)

  horarios     HorarioSemanal[]
  bloqueos     Bloqueo[]
  citas        Cita[]
  usuarios     Usuario[]

  @@index([empresaId])
  @@index([profesionalId])
}

model HorarioSemanal {
  id                 String   @id @default(uuid())
  recurso            RecursoAgendable @relation(fields: [recursoAgendableId], references: [id])
  recursoAgendableId String

  diaSemana  Int
  horaInicio String
  horaFin    String
  activo     Boolean  @default(true)

  @@index([recursoAgendableId])
}

model Bloqueo {
  id                 String   @id @default(uuid())
  recurso            RecursoAgendable @relation(fields: [recursoAgendableId], references: [id])
  recursoAgendableId String

  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String?

  @@index([recursoAgendableId])
}

// BLOQUEOS DE PROFESIONAL
model BloqueoProfesional {
  id              String   @id @default(uuid())
  profesional     Profesional @relation(fields: [profesionalId], references: [id])
  profesionalId   String
  empresa         Empresa @relation(fields: [empresaId], references: [id])
  empresaId       String

  fechaInicio DateTime
  fechaFin    DateTime
  motivo      String?

  @@index([profesionalId])
  @@index([empresaId])
}

// SERVICIOS
model Servicio {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  nombre    String
  duracionMinutos Int?
  activo    Boolean  @default(true)

  citas     Cita[]

  @@index([empresaId])
}

// CLIENTES
model Cliente {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  nombre    String
  rut       String?
  telefono  String?
  email     String?
  fechaNacimiento DateTime?

  fichaJson Json?

  consentimientoDatos Boolean @default(false)
  consentimientoFecha DateTime?

  optInCampanas Boolean @default(true)
  optInCampanasPreguntado Boolean @default(false)
  optInPreguntaPendiente  Boolean @default(false)

  recordatorioControlAnualEnviadoEn DateTime?

  creadoEn  DateTime @default(now())

  citas       Cita[]
  listaEspera ListaEspera[]
  ventas      Venta[]
  conversaciones Conversacion[]
  pedidos     Pedido[]

  @@index([empresaId])
  @@index([telefono])
}

// CITAS
enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_ASISTIO
}

model Cita {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String

  recurso   RecursoAgendable @relation(fields: [recursoAgendableId], references: [id])
  recursoAgendableId String

  servicio  Servicio? @relation(fields: [servicioId], references: [id])
  servicioId String?

  profesionalAsignado Profesional? @relation(fields: [profesionalAsignadoId], references: [id])
  profesionalAsignadoId String?

  fechaHoraInicio DateTime
  fechaHoraFin    DateTime
  estado    EstadoCita @default(PENDIENTE)

  confirmacionIntentos      Int      @default(0)
  confirmacionUltimoEnvioEn DateTime?
  canceladaPorNoConfirmar   Boolean  @default(false)

  googleEventId String?

  origenCanal String @default("whatsapp")

  creadoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([empresaId, fechaHoraInicio])
  @@index([clienteId])
  @@index([recursoAgendableId])
  @@index([profesionalAsignadoId])
}

// LISTA DE ESPERA
enum EstadoListaEspera {
  ESPERANDO
  OFRECIDO
  CONFIRMADO
  EXPIRADO
  CANCELADO
}

model ListaEspera {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String

  preferenciaRecursoId String?
  preferenciaFranja    String?

  estado    EstadoListaEspera @default(ESPERANDO)
  ofrecidoEn DateTime?
  expiraEn   DateTime?

  creadoEn  DateTime @default(now())

  @@index([empresaId])
}

// CONVERSACIONES
model Conversacion {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  clienteId String?

  telefono  String
  mensajes  Json
  escaladoAHumano Boolean @default(false)

  actualizadoEn DateTime @updatedAt
  creadoEn  DateTime @default(now())

  @@index([empresaId])
  @@index([telefono])
}

// VENTAS
enum EstadoPagoVenta {
  PAGADO
  PENDIENTE
}

model Venta {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String

  cliente   Cliente  @relation(fields: [clienteId], references: [id])
  clienteId String

  descripcion String
  monto       Int
  estadoPago  EstadoPagoVenta @default(PENDIENTE)

  fichaAsociadaId String?
  categoriaProducto String?

  creadoEn  DateTime @default(now())

  @@index([empresaId])
  @@index([clienteId])
}

// SUSCRIPCIÓN
enum PlanSuscripcion {
  PLAN_A
  PLAN_B
  PLAN_C
  PLAN_INICIO_LEGACY
}

enum EstadoSuscripcion {
  PENDIENTE_PAGO
  ACTIVA
  PAUSADA_POR_IMPAGO
  CANCELADA
}

model Suscripcion {
  id        String   @id @default(uuid())
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  empresaId String   @unique

  plan      PlanSuscripcion
  estado    EstadoSuscripcion @default(PENDIENTE_PAGO)

  tokenFlow String?

  fechaInicio           DateTime @default(now())
  fechaCambioPrecio     DateTime?
  montoMensualActual    Int
  citasIncluidas        Int
  precioCitaExcedente   Int

  fechaProximoCobro         DateTime
  fechaProximoCobroHosting  DateTime

  intentosFallidosConsecutivos Int @default(0)
  fechaUltimoPago               DateTime?

  pagos     Pago[]

  @@index([empresaId])
}

enum TipoPago {
  MENSUALIDAD
  HOSTING
  PRIMER_PAGO
  EXCEDENTE
}

enum EstadoPago {
  EXITOSO
  FALLIDO
}

model Pago {
  id             String   @id @default(uuid())
  suscripcion    Suscripcion @relation(fields: [suscripcionId], references: [id])
  suscripcionId  String

  tipo           TipoPago
  monto          Int
  valorUfDelDia  Float?
  estado         EstadoPago
  flowOrderId    String?
  boletaFolio    String?

  fecha          DateTime @default(now())

  @@index([suscripcionId])
}

// CATÁLOGO ROTATIVO
model Producto {
  id          String   @id @default(uuid())
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  empresaId   String

  nombre      String
  descripcion String?
  precio      Int
  unidad      String   @default("unidad")
  activo      Boolean  @default(true)

  creadoEn    DateTime @default(now())

  pedidoItems PedidoItem[]

  @@index([empresaId])
}

model CampanaEnvio {
  id          String   @id @default(uuid())
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  empresaId   String

  nombre      String
  diasSemana  Int[]
  hora        String

  plantillaWhatsapp String

  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  segmentada Boolean @default(false)
  segmentoDias Int?
  segmentoMontoMinimoClp Int?
  segmentoProductoIds String[] @default([])
  segmentoCategoriasProducto String[] @default([])

  enviosRealizados EnvioRealizado[]

  @@index([empresaId])
}

enum EstadoEnvioRealizado {
  BORRADOR
  ENVIADO
  CANCELADO
}

model EnvioRealizado {
  id          String   @id @default(uuid())
  campana     CampanaEnvio @relation(fields: [campanaId], references: [id])
  campanaId   String

  fechaProgramada DateTime
  estado      EstadoEnvioRealizado @default(BORRADOR)

  productosOfrecidosJson Json?

  fechaHoraEnvio    DateTime?
  destinatariosCount Int?

  costoEstimadoClp Int?

  mensajeDelDia String? @db.VarChar(400)

  creadoEn    DateTime @default(now())

  pedidos     Pedido[]

  @@index([campanaId])
  @@index([campanaId, fechaProgramada])
}

enum EstadoPedido {
  PENDIENTE
  CONFIRMADO
  LISTO
  ENTREGADO
  CANCELADO
}

model Pedido {
  id          String   @id @default(uuid())
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  empresaId   String

  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  clienteId   String

  envioRealizado   EnvioRealizado? @relation(fields: [envioRealizadoId], references: [id])
  envioRealizadoId String?

  estado      EstadoPedido @default(PENDIENTE)
  fechaRetiro DateTime?
  notas       String?

  productoPendienteId String?

  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  items       PedidoItem[]

  @@index([empresaId])
  @@index([clienteId])
  @@index([envioRealizadoId])
}

model PedidoItem {
  id          String   @id @default(uuid())
  pedido      Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId    String

  producto    Producto @relation(fields: [productoId], references: [id])
  productoId  String

  cantidad    Int      @default(1)
  precioUnitario Int

  @@index([pedidoId])
  @@index([productoId])
}

// CONTRATO
model ContratoAceptado {
  id            String   @id @default(uuid())
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  empresaId     String

  versionContrato String
  aceptoTerminos      Boolean
  aceptoDatosPacientes Boolean

  nombreQuienAcepta String
  emailQuienAcepta  String
  ipAddress         String?
  userAgent         String?

  fechaAceptacion   DateTime @default(now())

  @@index([empresaId])
}

// CRÉDITOS
model BilleteraCreditos {
  id            String   @id @default(cuid())
  empresaId     String   @unique
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  saldoActual   Int      @default(0)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  movimientos   MovimientoCredito[]
}

model MovimientoCredito {
  id            String              @id @default(cuid())
  billeteraId   String
  billetera     BilleteraCreditos   @relation(fields: [billeteraId], references: [id])
  tipo          TipoMovimientoCredito
  cantidad      Int
  saldoResultante Int
  montoClp      Int?
  campanaEnvioId String?
  nota          String?
  creadoEn      DateTime            @default(now())
}

enum TipoMovimientoCredito {
  COMPRA
  CONSUMO
  AJUSTE_MANUAL
}

model OrdenCompraCreditos {
  id              String    @id @default(cuid())
  empresaId       String
  empresa         Empresa   @relation(fields: [empresaId], references: [id])
  cantidadCreditos Int
  montoClp        Int
  estado          EstadoOrdenCredito @default(PENDIENTE)
  flowToken       String?   @unique
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt
}

enum EstadoOrdenCredito {
  PENDIENTE
  PAGADA
  RECHAZADA
  EXPIRADA
}

// DEMOS
model DemoAsignada {
  id              String   @id @default(cuid())
  telefono        String   @unique
  empresaDemoId   String
  empresaDemo     Empresa  @relation(fields: [empresaDemoId], references: [id])
  nombreProspecto String?
  creadoEn        DateTime @default(now())
  actualizadoEn   DateTime @updatedAt
  vendedor        Vendedor? @relation(fields: [vendedorId], references: [id])
  vendedorId      String?
  eliminadoEn         DateTime?
  telefonoOriginal    String?

  paso                Int   @default(0)
  historialSimulacion Json?
  carritoDemoJson     Json?
  citaDemoJson        Json?
  checkoutDemoJson    Json?
}

model Vendedor {
  id           String   @id @default(uuid())
  nombre       String
  email        String   @unique
  passwordHash String
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  demosCreadas DemoAsignada[]
}